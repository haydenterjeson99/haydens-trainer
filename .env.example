# Copy to .env.local for local dev. None of these are secrets — they ship in the
# client bundle by design. Every actual secret lives in Cloudflare Worker env vars.
#
# In GitHub Actions these are set as repository *Variables* (Settings > Secrets and
# variables > Actions > Variables), not Secrets.

# Google Cloud OAuth 2.0 Client ID, type "Web application".
VITE_GOOGLE_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# The Training calendar, not your primary calendar.
VITE_CALENDAR_ID=3d019ffc0de2c127d4742d84d32beeb2f9d38d8d6bef763733c3be77003e4181@group.calendar.google.com

# Deployed Cloudflare Worker origin. Leave blank to run the app with Strava and
# the note summariser switched off; everything else still works.
VITE_WORKER_URL=https://haydens-trainer-proxy.YOUR-SUBDOMAIN.workers.dev
